# Core runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/transform_church

# Browser build and hosting
# Use "/" at the domain root or a subpath such as "/training/" when the app is
# embedded or proxied by a CMS. Rebuild the frontend after changing this value.
PUBLIC_URL=/
# Leave blank when the frontend and API share an origin. Otherwise use the API
# origin without a trailing slash, for example https://api.example.com.
VITE_API_URL=
# External sign-in page that returns a signed token in the app URL fragment as
# "#access_token=<token>" or "#token=<token>". This is intentionally provider-neutral.
VITE_AUTH_LOGIN_URL=

# Provider-neutral bearer authentication
# Use a high-entropy value. The API verifies HS256 JWTs with this secret.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
# Bootstrap exactly one administrator on first sign-in. Set at least one of
# these to an immutable identity value from the external login provider, then
# remove it after the initial administrator has signed in.
INITIAL_ADMIN_EXTERNAL_USER_ID=
INITIAL_ADMIN_EMAIL=

# CORS and embedding
# Comma-separated trusted browser origins. Leave blank to allow only same-origin
# browser requests. Do not use "*" when credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.example.com
# Set true only when the chosen authentication architecture uses cookies.
CORS_ALLOW_CREDENTIALS=false
# Comma-separated CSP frame-ancestors values. Use "'self'" alone to disable
# third-party embedding, or add the WordPress/site origin explicitly.
FRAME_ANCESTORS='self',https://www.example.com

# Persistent local filesystem storage
# Mount this path to durable storage in production. Upload files are stored here,
# not in the database.
STORAGE_ROOT=./storage
STORAGE_PRIVATE_DIR=private
STORAGE_PUBLIC_DIRS=public
# High-entropy value used to sign short-lived direct-upload URLs.
STORAGE_SIGNING_SECRET=replace-with-a-different-long-random-secret
# Maximum image upload size; videos use the administrator-managed setting.
MAX_IMAGE_UPLOAD_SIZE_MB=20
# Public API origin used in direct upload URLs. Leave blank for same-origin apps.
PUBLIC_API_URL=

# Optional integrations
# Enables Google Drive folder import.
GOOGLE_API_KEY=
# Enables assignment email delivery.
RESEND_API_KEY=
EMAIL_FROM=training@example.com