{
  "name": "transform-church-platform",
  "version": "1.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm run dev --workspace=@workspace/api-server",
    "dev:web": "npm run dev --workspace=@workspace/transform-church",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@workspace/api-server",
    "start:web": "npm run start --workspace=@workspace/transform-church",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@workspace/db",
    "db:migrate": "npm run migrate --workspace=@workspace/db",
    "db:seed": "npm run seed --workspace=@workspace/db"
  },
  "private": true,
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5"
  }
}
